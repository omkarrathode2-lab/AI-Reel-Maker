# Own AI local development configuration
#
# For Expo Web on the development computer, localhost is used automatically.
# For the Android emulator, 10.0.2.2 is used automatically.
# For a physical Android/iPhone, set this to the COMPUTER running Own AI,
# not the phone's IP address. Both devices should be on the same Wi-Fi.
# Example: EXPO_PUBLIC_OWN_AI_HOST=192.168.1.25
EXPO_PUBLIC_OWN_AI_HOST=

# Optional: set full service base URLs when the services are deployed remotely.
# Do not include endpoint paths such as /api/generate-script.
# EXPO_PUBLIC_SCRIPT_API_BASE_URL=
# EXPO_PUBLIC_VIDEO_API_BASE_URL=
# EXPO_PUBLIC_VOICE_API_BASE_URL=
# EXPO_PUBLIC_CAPTION_API_BASE_URL=
# EXPO_PUBLIC_MUSIC_API_BASE_URL=
